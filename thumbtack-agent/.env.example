# Thumbtack harvester agent (box-only). Copy to .env on the box and fill in.

# The os API base. In prod: https://api.drbartender.com
API_BASE_URL=http://localhost:5000
# MUST match THUMBTACK_AGENT_SECRET on the os server.
THUMBTACK_AGENT_SECRET=

# Persistent logged-in Chrome profile. Log into Thumbtack ONCE via RDP into THIS dir
# (using Playwright's launchPersistentContext, not stock desktop Chrome).
CHROME_PROFILE_DIR=/home/drbartender/.thumbtack-profile

# Poll cadence and the human-pace jitter between leads.
POLL_INTERVAL_MS=300000
MIN_DELAY_MS=8000
MAX_DELAY_MS=25000

# Safety caps.
DAILY_CAP=40
BATCH_LIMIT=10
RENDER_TIMEOUT_MS=20000

# Optional: hard-set the pro email to exclude. Default reads it from __NEXT_DATA__.
PRO_EMAIL_OVERRIDE=

# Agent-side kill-switch (the server has one too). 'false' idles the HARVEST side only (the reply queue has its own server-side switch, TT_AUTOREPLY_ENABLED).
HARVESTER_ENABLED=true

# Auto first-reply queue (spec 2026-07-21). The loop ticks at the reply
# cadence; the harvest poll piggybacks every Nth tick to keep its pace above.
REPLY_POLL_INTERVAL_MS=25000
REPLY_DAILY_CAP=40
REPLY_BATCH_LIMIT=3
# Deterministic per-negotiation lead page; {id} is replaced. Tune during the
# live test if TT's path differs (no code change needed).
REPLY_LEAD_URL_TEMPLATE=https://www.thumbtack.com/pro-inbox/messages/{id}

# Rebuilt flow (2026-08-03): a pristine lead has NO composer until the respond
# CTA is clicked; TT then streams an AI draft that must be Cleared before the
# quick-reply pick. Both control labels are exact-match, case-insensitive,
# comma-separated, PRIORITY-ORDERED allowlists (earlier labels win when several
# are on the page; a label matching 2+ visible controls is ambiguous and fails
# closed) — tune from a diag capture (profile dir /diag) without a code change.
# NO allowlist match = NO click (fail-closed).
REPLY_CTA_LABELS=view and reply,reply,respond,approve,accept,respond to lead,accept lead,view and respond
REPLY_CLEAR_LABELS=clear
# Composer-textarea placeholder fragments (case-insensitive substring, any match).
# TT uses different placeholders per surface: "Type message" on answered threads,
# "Answer any questions..." on the pristine-lead respond panel (both live-pinned 8/03).
REPLY_COMPOSER_PLACEHOLDERS=type message,answer any questions
