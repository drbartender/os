#!/usr/bin/env sh
# pre-push: validates that a push was gated and reviewed, and never runs a
# gate itself.
#
# A push to main is the deploy. The gates (the money smoke, the exact Vercel
# client build, the static checks, the whole-tree docs check) run before the
# push, in `npm run ship`, through `node scripts/push-gate.js sha <sha>` in a
# throwaway worktree of its own, which writes a receipt keyed on the sha. This
# hook runs inside git's SSH window (git opens the connection before the hook
# runs, and on 2026-08-14 an eight-minute hook let GitHub close it, so a push
# failed after passing every gate), so it only reads: push-gate.js verify
# takes no lock and runs nothing.
#
# push-gate.js verify reads <git-common-dir>/drb-flip.json first (instruction
# rewrite spec 2026-10-19 sections 4.3 and 8; the flip was 2026-10-30):
#   - present: for a push to refs/heads/main only (any other remote ref is
#     refused), it refuses on a standing gate or watch marker, then checks
#     each pushed sha's sha receipt (<git-common-dir>/drb-gate/<sha>.json)
#     against origin/main, then the review receipts over origin/main..<sha>.
#     No receipt means refuse with "run npm run ship".
#   - absent: refuse. The legacy working-tree path that ran without the
#     marker is gone, so a missing marker was lost; the refusal ends with
#     the restore recipe (scripts/lib/markers.js flipRestore).
#   - unreadable: refuse until it is repaired by hand to the JSON the
#     refusal's recipe gives (the flip's full sha, pushed_at, written_by).
# Emergencies only, visible and per-push: git push --no-verify, or HUSKY=0.
set -e

node scripts/push-gate.js verify
