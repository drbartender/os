#!/usr/bin/env sh
# pre-push — two mechanical gates before a push reaches prod:
#   1. MONEY SMOKE  (runs when server/ changed) — the money-path test suites
#      against an isolated Neon ci-smoke branch (scripts/testdb-smoke.js).
#      Runs FIRST because it fails faster than the ~1 min client build.
#   2. CLIENT BUILD (runs when client/ changed) — the EXACT command Vercel runs
#      (CI=true react-scripts build), where ESLint warnings are FATAL. Nothing
#      else local catches that: lint-staged only covers server/, and a plain
#      `eslint` run treats it as a non-fatal warning.
#
# Both now live in scripts/push-gate.js so the hook and `npm run gate` can
# never drift, and so a gate that ALREADY passed for this exact tree is not
# re-run here. That re-run is what was breaking pushes: git opens the SSH
# connection before this hook runs, so an 8-minute hook left the connection
# idle until GitHub closed it, and the push then failed after passing
# everything (2026-08-14; see the header in scripts/push-gate.js).
#
# Fail-closed is unchanged: no receipt, a receipt for different bytes, or a
# stale one, and the full gate runs right here exactly as it always did.
# Emergencies only: git push --no-verify.
set -e

node scripts/push-gate.js verify
