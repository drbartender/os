#!/usr/bin/env sh
# Pre-commit hook: six checks on the commit's staged content, in order; every
# one but the CSS scope check refuses the commit.
#
# Husky runs it with `sh -e` from the worktree root. The docs check and the
# CLAUDE.md check read the index git is committing from (GIT_INDEX_FILE: the
# temporary index under a pathspec commit, the private copy under a lane
# merge), never the working tree; the invariants manifest and its script, the
# CSS check's class harvest and lint-staged read the working tree as before.
#   1. node scripts/gen-docs.js --check --staged: the six generated sections of
#      README.md and ARCHITECTURE.md against the index, and the header rule over
#      the staged added and modified source files; refuses with one line per
#      problem and a run: line saying what to do (docs/dev.md, Docs).
#   2. When .claude/CLAUDE.md is staged: its staged blob, written to a temp
#      file, through scripts/check-claudemd-invariants.sh --additive-against
#      HEAD; refuses when an invariant in scripts/claudemd-invariants.txt is
#      missing, when the working-tree manifest removes or changes a key HEAD's
#      manifest has (a commit that stages CLAUDE.md may only add keys), or when
#      the file is staged for deletion. The temp file is removed.
#   3. node scripts/check-file-size.js --staged: the file-size ratchet.
#   4. node scripts/check-css-palette-scope.js --staged: warn-only (below).
#   5. npx lint-staged: eslint on staged server/**/*.js.
#   6. bash scripts/guard-os-main.sh: the os checkout stays on main.
node scripts/gen-docs.js --check --staged || exit 1
# --no-renames so a rename away from .claude/CLAUDE.md shows as its deletion.
if git diff --cached --name-only --no-renames | grep -qxF '.claude/CLAUDE.md'; then
  claudemd_tmp=$(mktemp "${TMPDIR:-/tmp}/staged-CLAUDE.md.XXXXXX") || exit 1
  if ! git show :.claude/CLAUDE.md > "$claudemd_tmp" 2>/dev/null; then
    rm -f "$claudemd_tmp"
    echo "pre-commit: .claude/CLAUDE.md is staged with no blob to check (a deletion); refused"
    exit 1
  fi
  if ! bash scripts/check-claudemd-invariants.sh "$claudemd_tmp" --additive-against HEAD; then
    rm -f "$claudemd_tmp"
    echo "pre-commit: the invariants check refused the staged .claude/CLAUDE.md (the line above says which): MISSING is a rule the staged file dropped, restore it; REMOVED or CHANGED is a manifest key loosened in this commit, land the manifest change in a commit of its own with no CLAUDE.md staged; MALFORMED or any other line is a broken or unreachable scripts/claudemd-invariants.txt, fix it in a commit of its own"
    exit 1
  fi
  rm -f "$claudemd_tmp"
fi
node scripts/check-file-size.js --staged || exit 1
# No-ops instantly unless client/src/index.css is staged. Reports a commit that
# re-arms the legacy-palette trap (unscoped bare-element colour rules, or an
# admin-reachable class rule painting an Apothecary token into invisibility).
#
# DELIBERATELY WARN-ONLY (2026-08-14), do not "fix" this back to || exit 1.
# It is a brand-new 600-line CSS parser and index.css is the largest file in the
# repo; a false positive here costs the author --no-verify, which ALSO skips
# check-file-size, lint-staged and guard-os-main. It prints, it does not veto.
# The exit code still means something: npm run check:css-scope exits non-zero on
# the same finding, so CI can gate on it and the hook can be promoted to
# blocking once the parser has a burn-in period behind it.
node scripts/check-css-palette-scope.js --staged || true
npx lint-staged
bash scripts/guard-os-main.sh || exit 1
