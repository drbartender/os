{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/command/**",
              "components/icon/**",
              "components/metrics/**",
              "components/navigation/**",
              "components/overlay/**",
              "components/staff/**",
              "components/status/**",
              "components/table/**",
              "ui_kits/admin/**",
              "ui_kits/staff/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|JetBrains Mono|Libre Caslon Text))/i]",
        "message": "Font not provided by the design system. Available: Inter, JetBrains Mono, Libre Caslon Text."
      },
      {
        "selector": "JSXOpeningElement[name.name='AreaChartDatum'] > JSXAttribute > JSXIdentifier[name!=/^(?:m|key|ref|className|style|children)$/]",
        "message": "<AreaChartDatum> doesn't accept that prop. Declared props: m."
      },
      {
        "selector": "JSXOpeningElement[name.name='CommandItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|detail|key|ref|className|style|children)$/]",
        "message": "<CommandItem> doesn't accept that prop. Declared props: label, icon, detail."
      },
      {
        "selector": "JSXOpeningElement[name.name='TableCell'] > JSXAttribute > JSXIdentifier[name!=/^(?:content|className|num|muted|primary|sub|key|ref|className|style|children)$/]",
        "message": "<TableCell> doesn't accept that prop. Declared props: content, className, num, muted, primary, sub."
      },
      {
        "selector": "JSXOpeningElement[name.name='DocumentPreviewModal'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|title|src|kind|onDownload|key|ref|className|style|children)$/]",
        "message": "<DocumentPreviewModal> doesn't accept that prop. Declared props: open, onClose, title, src, kind, onDownload."
      },
      {
        "selector": "JSXOpeningElement[name.name='DocumentPreviewModal'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:image|frame)$/]",
        "message": "<DocumentPreviewModal> kind must be one of 'image' | 'frame'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Drawer'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|crumb|onOpenPage|footer|children|key|ref|className|style|children)$/]",
        "message": "<Drawer> doesn't accept that prop. Declared props: open, onClose, crumb, onOpenPage, footer, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Header'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|onOpenPalette|onQuickAdd|unread|key|ref|className|style|children)$/]",
        "message": "<Header> doesn't accept that prop. Declared props: title, onOpenPalette, onQuickAdd, unread."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='KebabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|danger|disabled|href|onClick|key|ref|className|style|children)$/]",
        "message": "<KebabItem> doesn't accept that prop. Declared props: label, icon, danger, disabled, href, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricsFilter'] > JSXAttribute > JSXIdentifier[name!=/^(?:basis|includeCc|activePreset|setPreset|setBasis|setIncludeCc|key|ref|className|style|children)$/]",
        "message": "<MetricsFilter> doesn't accept that prop. Declared props: basis, includeCc, activePreset, setPreset, setBasis, setIncludeCc."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricsFilter'] > JSXAttribute[name.name='basis'] > Literal[value!=/^(?:booked|scheduled|paid)$/]",
        "message": "<MetricsFilter> basis must be one of 'booked' | 'scheduled' | 'paid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricsFilter'] > JSXAttribute[name.name='includeCc'] > Literal[value!=/^(?:all|exclude|only)$/]",
        "message": "<MetricsFilter> includeCc must be one of 'all' | 'exclude' | 'only'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|value|delta|deltaDir|sub|key|ref|className|style|children)$/]",
        "message": "<MetricTile> doesn't accept that prop. Declared props: label, icon, value, delta, deltaDir, sub."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetricTile'] > JSXAttribute[name.name='deltaDir'] > Literal[value!=/^(?:up|down|flat)$/]",
        "message": "<MetricTile> deltaDir must be one of 'up' | 'down' | 'flat'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StaffShift'] > JSXAttribute > JSXIdentifier[name!=/^(?:when|rel|today|name|type|time|venue|pay|state|key|ref|className|style|children)$/]",
        "message": "<StaffShift> doesn't accept that prop. Declared props: when, rel, today, name, type, time, venue, pay, state."
      },
      {
        "selector": "JSXOpeningElement[name.name='StaffShift'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:confirmed|needs-action)$/]",
        "message": "<StaffShift> state must be one of 'confirmed' | 'needs-action'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PayoutRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|period|amount|status|statusKind|onClick|key|ref|className|style|children)$/]",
        "message": "<PayoutRow> doesn't accept that prop. Declared props: label, period, amount, status, statusKind, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ShiftRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:shift|onClick|key|ref|className|style|children)$/]",
        "message": "<ShiftRow> doesn't accept that prop. Declared props: shift, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|icon|path|badge|badgeTone|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: id, label, icon, path, badge, badgeTone."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute[name.name='badgeTone'] > Literal[value!=/^(?:warn|danger)$/]",
        "message": "<NavItem> badgeTone must be one of 'warn' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sparkline'] > JSXAttribute > JSXIdentifier[name!=/^(?:data|stroke|width|height|key|ref|className|style|children)$/]",
        "message": "<Sparkline> doesn't accept that prop. Declared props: data, stroke, width, height."
      },
      {
        "selector": "JSXOpeningElement[name.name='StaffPosition'] > JSXAttribute > JSXIdentifier[name!=/^(?:role|name|status|key|ref|className|style|children)$/]",
        "message": "<StaffPosition> doesn't accept that prop. Declared props: role, name, status."
      },
      {
        "selector": "JSXOpeningElement[name.name='StaffTab'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|icon|key|ref|className|style|children)$/]",
        "message": "<StaffTab> doesn't accept that prop. Declared props: id, label, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='StaffMenuItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|icon|label|tone|onClick|key|ref|className|style|children)$/]",
        "message": "<StaffMenuItem> doesn't accept that prop. Declared props: id, icon, label, tone, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='StaffMenuItem'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:danger)$/]",
        "message": "<StaffMenuItem> tone must be one of 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|dot|children|key|ref|className|style|children)$/]",
        "message": "<StatusChip> doesn't accept that prop. Declared props: kind, dot, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToolbarTab'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|count|key|ref|className|style|children)$/]",
        "message": "<ToolbarTab> doesn't accept that prop. Declared props: id, label, count."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
