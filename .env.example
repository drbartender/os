# Server

# PORT: the server port (default: 5000). NODE_ENV: `development` or `production`.
PORT=5000
NODE_ENV=development

# Database

# Required. PostgreSQL connection string.
DATABASE_URL=postgresql://username:password@localhost:5432/dr_bartender

# JWT

# Required. Long random string for signing tokens: the token signing key.
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# Optional. Separate signing key for unsubscribe / marketing-link JWTs (365-day lifetime). Falls
# back to `JWT_SECRET` if unset; set it in prod to isolate a marketing-token compromise from auth.
UNSUBSCRIBE_SECRET=

# WebAuthn, for the phone-admin passkey unlock (mobile admin, spec 2026-08-13 section 8; read by
# `routes/webauthn.js`). Both optional: the code defaults them.
# WEBAUTHN_RP_ID, the RP ID override, defaults to `admin.drbartender.com` in prod and `localhost`
# in dev. It is pinned to the admin host on purpose and is never a bare domain: one bundle serves
# four hosts, and a bare-domain RP ID would let an admin passkey assert from the
# public/hiring/staff origins.
# WEBAUTHN_ORIGIN, the expected origin override, defaults to `https://admin.drbartender.com` in
# prod and to the localhost origins in dev, `http://localhost:3000` + `http://admin.localhost:3000`.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=

# Encryption

# Required for bank PII. The key for bank-account data at rest: a 64-hex-char (32-byte)
# AES-256-GCM key encrypting the bank-account PII fields (`server/utils/encryption.js`). Fails
# closed in prod when unset. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# File Upload

# UPLOAD_DIR: nothing in the code reads it today; uploads go to Cloudflare R2 (below).
# MAX_FILE_SIZE: the upload size limit in bytes (default `10485760` = 10MB), applied by the
# file-upload middleware in `server/index.js`.
UPLOAD_DIR=./server/uploads
MAX_FILE_SIZE=10485760

# Email (Resend)

# Required for email (RESEND_API_KEY).
# Required for email tracking (RESEND_WEBHOOK_SECRET).
# RESEND_API_KEY: the Resend API key, for email. RESEND_WEBHOOK_SECRET: the Resend webhook signing
# secret (svix).
RESEND_API_KEY=re_your_api_key_here
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret_here

# Client

# Required. The admin/staff frontend origin, for CORS + admin-facing links (e.g., admin dashboard
# URLs in admin emails): `http://localhost:3000` in dev, `https://admin.drbartender.com` in prod.
CLIENT_URL=http://localhost:3000

# Required. The public marketing site origin, used in client-facing token links (proposals, drink
# plans, invoices, shopping lists): `http://localhost:3000` in dev, `https://drbartender.com` in
# prod. Use this domain in any URL that gets sent to a customer. Defaults to
# https://drbartender.com in prod.
PUBLIC_SITE_URL=http://localhost:3000

# Optional. Staff portal origin used in hire-confirmation emails + staff calendar/portal links:
# `http://localhost:3000` in dev, `https://staff.drbartender.com` in prod. Defaults to
# `https://staff.drbartender.com` (the prod URL) when unset.
STAFF_URL=http://localhost:3000

# Client build variable, never read by the server: the client-side API base URL, the backend's
# absolute URL (the Render service). Set it in Vercel and in `client/.env.production`;
# `client/src/utils/api.js` calls it plus `/api`, and the public pages that fetch outside `api.js`
# read it too. Unset, the client calls `/api` on its own origin.
# REACT_APP_API_URL=

# File Storage (Cloudflare R2)

# Required for uploads. The Cloudflare R2 credentials: R2_ACCOUNT_ID the account ID,
# R2_ACCESS_KEY_ID the access key, R2_SECRET_ACCESS_KEY the secret key, R2_BUCKET_NAME the bucket
# name.
R2_ACCOUNT_ID=your_account_id_here
R2_ACCESS_KEY_ID=your_access_key_id_here
R2_SECRET_ACCESS_KEY=your_secret_access_key_here
R2_BUCKET_NAME=your_bucket_name_here

# Admin Seed Account

# Required for seed.
# ADMIN_EMAIL: the admin account email and admin inbox address. It is the seed account's email and
# the default `Reply-To` on every client-facing email sent via `sendEmail`; set it to a monitored
# inbox in prod so client replies do not bounce. Unset, those emails fall through to no
# `Reply-To` header.
# ADMIN_PASSWORD: the admin account password, for the seeded admin account
# (`server/scripts/createAdmin.js`, `server/db/seed.js`).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
# Optional. E.164 admin hotline: the first ring of the lead-call and consult-call bridges, plus
# urgent admin SMS (change requests, dead letters, emergency drops). INTERNAL ROUTING ONLY: NEVER
# print it to a client (client-facing numbers come from `server/utils/companyPhone.js`), and
# point it at the 312 Google Voice line, never a personal cell; until 2026-10-02 the drink-plan
# nudge printed it, and it held Dallas's personal cell. Used by the lead-call bridge ring order
# (`ADMIN_PHONE` → `VA_CELL`), inside-T14 change-request SMS, dispatcher dead-letter alerts, and
# urgent inbound-SMS alerts. It is also the consult call bridge's first ring: unset there, the
# chain skips Dallas entirely and opens on Zul's leg with the briefing that never says he missed a
# call. Unset → those SMS legs are skipped. NOTE it does **not** drive the ≤72h last-minute
# booking alert, which fans out via `notifyAdminCategory('urgent_booking')` to subscribed
# admins/managers and never reads this var.
ADMIN_PHONE=+1xxxxxxxxxx

# SMS (Twilio)

# Required for SMS. The Twilio SMS credentials: TWILIO_ACCOUNT_SID the account SID,
# TWILIO_AUTH_TOKEN the auth token, TWILIO_PHONE_NUMBER the sender number (the 888 line; the two
# 224 lines are fixed in `server/utils/smsLines.js`). `TWILIO_AUTH_TOKEN` is also used to verify
# the inbound-SMS webhook signature (`POST /api/sms/inbound`) and the message status callback
# (`POST /api/sms/status`).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
# Lines a human reply may text from (the Messages reply and the Inbox reply), as a comma list of
# `888`, `1922`, `0082`. Default `888`; unknown keys are ignored and the 888 is always on. Add a
# 224 line only after its round trip (a reply, a STOP and a START) shows up in
# `sms_messages` with the right `metadata.to` (spec 2026-10-06, decision 19).
INBOX_TEXT_LINES=888

# Payments (Stripe - live mode)

# Required for payments (STRIPE_SECRET_KEY, STRIPE_PUBLISHABLE_KEY, STRIPE_WEBHOOK_SECRET).
# The Stripe live payments credentials: STRIPE_SECRET_KEY the live secret key,
# STRIPE_PUBLISHABLE_KEY the live publishable key (served to the client via
# `/api/stripe/publishable-key`), STRIPE_WEBHOOK_SECRET the live webhook signing secret.
# STRIPE_DEPOSIT_AMOUNT: the deposit in cents (default: 10000 = $100).
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
STRIPE_DEPOSIT_AMOUNT=10000

# Payments (Stripe - test mode, optional)

# Required for test mode (STRIPE_SECRET_KEY_TEST, STRIPE_PUBLISHABLE_KEY_TEST, STRIPE_WEBHOOK_SECRET_TEST).
# Optional (STRIPE_TEST_MODE_UNTIL).
# The Stripe test-mode credentials: STRIPE_SECRET_KEY_TEST the test secret key (used while
# `STRIPE_TEST_MODE_UNTIL` is in the future), STRIPE_PUBLISHABLE_KEY_TEST the test publishable
# key, STRIPE_WEBHOOK_SECRET_TEST the test webhook signing secret.
# STRIPE_TEST_MODE_UNTIL: an ISO 8601 cutoff date. While it is set and in the future, every Stripe
# call uses the `*_TEST` credentials below; after the cutoff passes, the next request
# automatically reverts to the live credentials above, with no redeploy.
#
# **The date must be in the FUTURE.** A cutoff already past (or malformed, or empty) reads as
# "configured for test" and silently means LIVE: real cards, real money, because `isTestMode()`
# tests `Date.now() < cutoff` and fails open. That is not hypothetical: this file and the README
# table both used to carry a fixed sample date, it went stale, and a stale sample date was pasted
# verbatim into a real `.env` on 2026-08-19 and read as "configured for test" while charging live.
# Use a far-future date so it cannot expire out from under you, e.g. `2099-12-31T23:59:59Z`, and
# verify `isTestMode()` rather than trusting the file.
#
# NOTE the dev box deliberately runs against LIVE Stripe (operator work is done from it: payment
# links, refunds, customer writes). Leave these unset there unless you specifically want test
# mode for a session.
STRIPE_SECRET_KEY_TEST=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY_TEST=pk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET_TEST=whsec_xxxxxxxxxxxxxxxxxxxx
STRIPE_TEST_MODE_UNTIL=

# Tip QR page

# Required for tip pages. The Google review URL for the tip thank-you flow: the public review
# destination shown after a tip submission. Set the same URL on both the server (for
# emails / token links) and the client (REACT_APP_*) sides. PUBLIC_GOOGLE_REVIEW_URL is the
# server-side URL surfaced from the tip thank-you flow; REACT_APP_GOOGLE_REVIEW_URL is the client
# build-time URL (same value as `PUBLIC_GOOGLE_REVIEW_URL`).
PUBLIC_GOOGLE_REVIEW_URL=https://g.page/r/PLACEHOLDER/review
REACT_APP_GOOGLE_REVIEW_URL=https://g.page/r/PLACEHOLDER/review
# Required for tip pages. The inbox that receives bartender feedback submissions from the tip
# thank-you flow. Default: the contact address, the value below.
ADMIN_FEEDBACK_NOTIFICATION_EMAIL=contact@drbartender.com

# Thumbtack Integration

# Required for Thumbtack. Shared secret for Thumbtack webhook auth.
THUMBTACK_WEBHOOK_SECRET=your_thumbtack_webhook_secret_here
# Required for harvester. Shared secret for the Thumbtack box-agent surface
# (`/api/admin/thumbtack/*`: email harvesting + auto first-reply): the email-harvester agent (the
# box-only poller + the admin manual-paste UI, the admin-paste routes) and the auto first-reply.
# Timing-safe compare; the agent routes **fail closed (401) in every environment when unset**.
# Generate a long random value; never commit it.
# BLAST RADIUS (2026-07-21): the secret now also reads customer names (pending-first-replies), can
# trigger window-bypassed call chains one-shot per pending day lead (first-reply-sent), and can
# suppress replies (first-reply-failed x3). Leak response: rotate the secret AND flip
# `TT_AUTOREPLY_ENABLED` + `LEAD_CALL_ENABLED`.
THUMBTACK_AGENT_SECRET=
# Optional. Kill-switch for the harvester: set to `false` to make
# `GET /api/admin/thumbtack/pending-harvest` return `[]` (a redeploy-free stop) and to idle
# the box agent. Defaults on when unset.
HARVESTER_ENABLED=true
# Optional. Transient-failure retry cap for the agent before a harvest lead is marked `failed`.
# Default 3.
MAX_HARVEST_ATTEMPTS=3
# Optional. Postgres interval before a leased-but-unresolved harvest lead is re-offered by
# `pending-harvest`. Default `'6 hours'`.
HARVEST_COOLDOWN_INTERVAL=6 hours

# Venue search, Inbox and menu art (Google Places, Anthropic, Gmail, OpenAI, Gemini)

# Required for venue search. Google Places API (New) key for venue-name search.
# Server-only. When unset, the venue search degrades to a plain text input.
GOOGLE_PLACES_API_KEY=

# Required for the Inbox AI read. Server-only Anthropic key; it enables the Inbox AI read (spec
# 2026-10-06 section 6) and is read only by `server/utils/anthropicClient.js`. Unset (the dev box,
# which runs without it) means the read is off: no calls, an unread question stays waiting,
# replies still close items, and the Inbox feed line says the AI read is off.
# The read also takes email and Zola lines (spec 2026-10-14 section 6): the subject rides ahead of
# the words, an attachment is `[attachment]`, never a filename, and an email line keeps 8,000
# characters before redaction and 4,000 after (a text 3,000 and 1,500); a Sent mail to several
# people is read once. The inbound read returns a `solicitation` flag (a vendor pitch, a
# sponsorship ask, recruiting, a survey): the job stores it in `inbox_reads.solicitation` with
# `needs_reply` forced true, so a pitch never closes on its own and its row carries the Pitch
# chip. Personal mail is never read.
# Set in Render 2026-10-06; replaced 2026-10-14 by a service-account key scoped to the Default
# Workspace. The key MUST be scoped to one workspace: the server sends no `anthropic-workspace-id`
# header, so an unscoped key (a multi-workspace personal or service-account key) fails every call
# with a content-free 400 (the 2026-10-14 switch-on: 59 subjects spent their attempts before a
# probe with the key named it). Smoke a new key against the real request before it goes into
# Render (walkthroughs-owed, Inbox).
ANTHROPIC_API_KEY=
# Optional. Model for the AI read: `claude-opus-5-5` (the default, sent at low effort,
# `output_config.effort: 'low'`, with the server-side refusal fallback, `fallbacks: "default"`
# under beta `server-side-fallback-2026-07-01`) or `claude-haiku-4-5` (cheaper: about a quarter of
# the cost; the request then leaves out effort and the fallback, which the claude-api docs do not
# list for it). Any other value falls back to the default, with one console warning at boot.
# INBOX_AI_MODEL=claude-opus-5-5
# Optional. Max AI read ATTEMPTS per rolling 24 hours, counted from `inbox_reads` (default 300;
# `0`, blank or nonsense fall back to 300, the `LEAD_CALL_DAILY_CAP` precedent). A typical read is
# about 2 to 3 cents and the ceiling about 10 cents (`max_tokens` 4096 spent on output), so the
# cap's worst day is about $30. At the cap reads pause, a Sentry warning goes out at most once an
# hour, and the feed line says paused. The off switches are the key and
# `RUN_INBOX_READ_SCHEDULER=false`.
# INBOX_AI_DAILY_CAP=300
# Optional. Set to `false` to disable the 60-second Inbox AI read scheduler (`inbox_ai_read`,
# first run 40 s after boot); at `false` the Inbox feed line says the AI read is off. Default on.
# Honored only when `RUN_SCHEDULERS` is not `false`. Render had it at `false` from 2026-10-09;
# Dallas set it to `true` on 2026-10-14 and the read is live (the Neon transfer call on the fix
# list is now measured against real usage).
RUN_INBOX_READ_SCHEDULER=
# Required for the Inbox email feed (spec 2026-10-14). Base64 of the service account's JSON key.
# Server-only, read only by `server/utils/gmailClient.js`; the mailbox it reads is a code constant
# there. Unset means the Gmail feed is off. Smoke a new key with `scripts/gmail-probe.js` before
# Render. BLAST RADIUS: under domain-wide delegation the key can read every mailbox in the
# Workspace, not only the business one. Leak response: delete the key in Google Cloud and remove
# the delegation row in the Workspace admin console. Keep the downloaded JSON in `~/.secrets/`
# (chmod 600) and delete it once the value is in Render.
GMAIL_SERVICE_ACCOUNT_KEY=
# Optional comma list of extra addresses that are "us" and never form an item (the older Gmail
# address of the business). The mailbox, its aliases and every admin's and manager's address are
# ours without being listed. With the mailbox and the personal alias, these are also the only
# addresses the Zola replay gate counts as addressed to us (`gmailRules.isMailboxRecipient`, as
# written or without a +tag; an admin's or manager's own address, `FROM_EMAIL` and `ADMIN_EMAIL`
# are not). With the mailbox, the no-reply address
# `FROM_EMAIL` sends from, `ADMIN_EMAIL` and the own address of every admin and manager but the
# owner (`PERSONAL_MAILBOX_OWNER_USER_ID`), they are also the business addresses whose presence
# in To or Cc makes a mail at the personal alias business mail rather than personal
# (`people.businessEmails`, read by `personalMail.js`).
INBOX_OWN_EMAILS=
# Optional. `false` disables the 60-second Gmail sync. Default on. Honored only when
# `RUN_SCHEDULERS` is not `false`.
RUN_GMAIL_SYNC_SCHEDULER=

# Required for menu art. Enables the menu art generator (spec 2026-10-01). Server-only, read only
# by `server/utils/openaiClient.js`. Unset means the feature is off: `configured.openai` is false,
# Generate, re-roll and Update draft answer 503 `MENU_ART_NOT_CONFIGURED` (no Sentry page), and
# an existing draft can still be viewed, edited and approved. Before it goes into Render, set a
# monthly budget on the OpenAI project too: that is the provider-side backstop behind the daily
# cap. Dev and prod share one key, so they share OpenAI's per-minute limit; each database keeps
# its own cap. The wrapper refuses every call while `OPENAI_CUSTOM_HEADERS` is set (blank
# included), since the SDK would let it replace the auth headers: leave it unset.
OPENAI_API_KEY=
# Optional. OpenAI model ids, stamped on each piece when it is asked for.
# MENU_ART_IMAGE_MODEL: the OpenAI image model, default `gpt-image-2.5-sunburst`; the job draws
# with the stamped id, never the env value at run time.
# MENU_ART_TEXT_MODEL: the structured-output model for the words step, default `gpt-5.4-mini`.
# MENU_ART_IMAGE_MODEL=gpt-image-2.5-sunburst
# MENU_ART_TEXT_MODEL=gpt-5.4-mini
# Optional. OpenAI background size, default `2560x3200`; `1664x2080` is the non-experimental
# fallback.
# MENU_ART_BACKGROUND_SIZE=2560x3200
# Optional. Rolling 24-hour ceilings counted from `menu_art_calls`.
# MENU_ART_DAILY_IMAGE_CAP: image reservations across all events and BOTH providers, counted from
# `menu_art_calls` rows of kind `image` not `released` (default 60). At the cap Generate, re-roll
# and Update draft answer 429 `MENU_ART_CAP_REACHED` and nothing is called. About $15 on a worst
# day on OpenAI, about $14.40 on Gemini.
# MENU_ART_DAILY_TEXT_CAP: words calls, Generate and Update draft (default 100); at the cap 429
# `MENU_ART_TEXT_CAP_REACHED`. Text rows never count against the image cap.
# These two and the two below (`MENU_ART_IMAGE_TIMEOUT_MS`, `MENU_ART_STALE_MS`) parse through
# `server/utils/envInt.js`: `0`, blank or nonsense falls back to the default with one warning, so
# a typo can never uncap a provider.
# MENU_ART_DAILY_IMAGE_CAP=60
# MENU_ART_DAILY_TEXT_CAP=100
# Optional.
# MENU_ART_IMAGE_TIMEOUT_MS: the per image call timeout on both providers (default 180000). Text
# calls use a fixed 60000.
# MENU_ART_STALE_MS: the heartbeat age at which a pending or working piece, or the words step,
# reads as failed ("interrupted") and its re-roll is allowed (default 300000, above one image
# timeout plus one retry wait). Covers a server restart, which skips the job's end-of-run sweep.
# These four menu art numbers (the two daily caps above and these two) must be whole positive
# numbers: `0`, blank or nonsense falls back to the default with one warning, so a typo can never
# uncap a provider.
# MENU_ART_IMAGE_TIMEOUT_MS=180000
# MENU_ART_STALE_MS=300000
# Optional. Enables the Gemini option of the menu art image-model toggle. Server-only, read only
# by `server/utils/geminiClient.js`. Unset means `configured.gemini` is false, the toggle's Gemini
# option is disabled, a `gemini` request answers 503 `MENU_ART_GEMINI_NOT_CONFIGURED`, and OpenAI
# is unaffected. In Render it must come from a billing-enabled AI Studio project (paid tier, so
# prompts and images are not used for training) with a hard ceiling: prepay without auto-refill,
# or a project spend cap; preferably a separate project from the second-opinion reviewer's, so
# menu art and code review do not share a spend limit. On the dev
# box the live smoke and the walks pass the reviewer's paid key from `~/.gemini/.env` into the
# lane server's process environment only, bounded by the dev database's own cap; it never goes
# into the root `.env`. BLAST RADIUS: the key can draw images billed to that project. Leak
# response: delete the key in AI Studio and unset it in Render; OpenAI keeps working. The wrapper
# refuses every call while `GOOGLE_GENAI_DEBUG` (it would log the key) or
# `GOOGLE_GENAI_USER_PROJECT` (it would move the billing) is set: leave both unset.
GEMINI_API_KEY=
# Optional. Gemini image model for backgrounds and drinks, default `gemini-3-pro-image`. Only that
# id is supported (it takes style references); other ids are untested.
# MENU_ART_GEMINI_IMAGE_MODEL=gemini-3-pro-image

# Render

# Auto-set by Render in production; do not set it locally. The service's own public URL, which the
# backend origin `API_URL` falls back to (`server/utils/urls.js`).
# RENDER_EXTERNAL_URL=https://your-service.onrender.com

# Optional. Backend origin for server-rendered email links (unsubscribe, etc). Defaults to
# `RENDER_EXTERNAL_URL` in prod, `http://localhost:5000` in dev; set it explicitly if the backend
# ever moves behind a CDN or custom domain.
# API_URL=https://api.drbartender.com

# Sentry

# Required for error tracking. Leave unset in dev to disable error reporting.
# SENTRY_DSN_SERVER: the server-side Sentry DSN. REACT_APP_SENTRY_DSN_CLIENT: the client-side
# Sentry DSN. Each is optional in dev and required in prod.
SENTRY_DSN_SERVER=
REACT_APP_SENTRY_DSN_CLIENT=

# Scheduler and outbound-send gates

# Schedulers fire only when `NODE_ENV=production` (Render sets this by default). In any other
# environment they default to OFF, so a local dev server never burns Resend/Twilio allotments by
# iterating the shared Neon DB.
#   RUN_SCHEDULERS=true   force-on locally (testing a handler against a scratch row)
#   RUN_SCHEDULERS=false  force-off on a secondary prod instance to prevent duplicate runs
RUN_SCHEDULERS=

# Real outbound notifications, email (Resend), SMS (Twilio) and Web Push, fire only when
# `NODE_ENV=production` by default (the same philosophy as `RUN_SCHEDULERS`), so a local dev
# server never burns provider allotments (Resend/Twilio) against the shared Neon DB. Web Push
# rides the same gate since 2026-10-14.
#   SEND_NOTIFICATIONS=true   force real sends locally (e.g. a real send to a scratch row)
#   SEND_NOTIFICATIONS=false  force off everywhere (e.g. a secondary prod instance)
# When gated off, `sendEmail`/`sendSMS` take their existing log-and-skip path, and `sendPush`
# (`pushSender.js`) logs the push service's host and returns
# `{ ok: false, error: 'notifications_off' }`, so a dev server on the shared DB never buzzes a
# real phone.
SEND_NOTIFICATIONS=

# ─── Automated Communication: scheduler controls ─────────────────

# Optional. Per-scheduler disable: set `RUN_<NAME>_SCHEDULER=false` to disable that specific
# scheduler. Honored only when schedulers are running (i.e. on prod, or locally with
# `RUN_SCHEDULERS=true`): only when `RUN_SCHEDULERS` is not `false` (the global flag wins). When
# schedulers are globally disabled, these are ignored. `RUN_MESSAGE_DISPATCHER_SCHEDULER` disables
# the scheduled-message dispatcher (balance reminders, plus future drip / event-week handlers),
# which defaults on.
# RUN_AUTOPAY_SCHEDULER=true
# RUN_AUTOCOMPLETE_SCHEDULER=true
# RUN_AUTO_ASSIGN_SCHEDULER=true
# RUN_SEQUENCE_SCHEDULER=true
# RUN_QUOTE_DRAFT_CLEANUP_SCHEDULER=true
# RUN_MESSAGE_DISPATCHER_SCHEDULER=true

# Cal.com (consult booking)

# Required for Cal.com. HMAC-SHA256 signing secret for the Cal.com webhook; required in prod. Fails
# closed: the webhook returns 503 if unset. See
# docs/superpowers/specs/2026-05-26-cal-com-integration-design.md.
CAL_WEBHOOK_SECRET=

# Required for Cal.com. The public Cal.com booking page URL. Hosted:
# https://cal.com/<username>/<event-type>. Self-hosted: https://book.drbartender.com/<event-type>.
# Surfaced in 3 client comms touches (drink-plan nudge email + SMS, six-months-out
# marketing). Optional in dev; templates omit the consult line when unset.
CAL_BOOKING_URL=

# Optional. Set to `false` to disable the hourly `webhook_events` 30-day prune scheduler. Default
# on. Honored only when `RUN_SCHEDULERS` is not `false`.
RUN_WEBHOOK_EVENTS_PRUNE_SCHEDULER=

# Optional. Set to `false` to disable the daily `pending_email_changes` 7-day purge, the cleanup
# scheduler (spec §6.10). Default on. Honored only when `RUN_SCHEDULERS` is not `false`.
RUN_PENDING_EMAIL_CLEANUP_SCHEDULER=

# Optional. Set to `false` to disable the daily Stripe payout mirror sweep (webhook-miss heal,
# pending bucket, re-match). Default on (prod only, like all schedulers). Honored only when
# `RUN_SCHEDULERS` is not `false`.
RUN_STRIPE_PAYOUT_SWEEP_SCHEDULER=

# Optional. Set to `false` to disable the 15-minute stale-pending-refund sweep, which heals aged
# `pending` `proposal_refunds` rows: it reconciles rows stuck `pending` >30 min against Stripe
# (`stripe.refunds.list`), adopting the real, matching refund, or marks them failed after that
# 30-min age gate. Default on. Honored only when `RUN_SCHEDULERS` is not `false`.
RUN_REFUND_PENDING_SWEEP_SCHEDULER=

# **Opt-in, not opt-out: the only scheduler flag that works this way**, unlike every other RUN_*
# flag above. Must be exactly `true` to run the hourly stale-proposal sweep, which archives
# past-dated proposals that were never booked (`archive_reason = 'event_passed'`), voids their
# unpaid invoices, reaps shifts, and deletes their pending scheduled messages. Unset keeps it
# dark even when `RUN_SCHEDULERS=true`, because its first run voids ~105 invoices and makes ~220
# LIVE Stripe calls, and this box talks to live Stripe by design.
RUN_STALE_PROPOSAL_SWEEP_SCHEDULER=
# Set to `true` to make the stale-proposal sweep above log its candidate list and the past-dated
# `accepted` proposals it would leave for an admin, while writing nothing, sending nothing, and
# calling no Stripe. Use it before the first real run.
STALE_PROPOSAL_SWEEP_DRY_RUN=

# Optional. Set to `false` to disable the 60-second service-extension expiry sweep: it expires a
# pending request past its grace window (single-winner claim against the payment webhook), voids
# its invoice, and sends the staff decline that carries the insurance warning. The same tick heals
# crashed settles (settled-but-unfinalized rows, `finalized_at` NULL). Default on. Honored only
# when `RUN_SCHEDULERS` is not `false`.
RUN_SERVICE_EXTENSION_SWEEP_SCHEDULER=

# Optional. Set to `false` to disable the hourly shift-closure sweep (`shiftClosureSweep.js`),
# which closes a shift to `completed` once the SHIFT's own end instant has passed AND its
# proposal is `completed`. It NEVER writes `cancelled`: that value is an EVENT-cancelled signal
# read by the Events dashboard chip and by the iCal feed (STATUS:CANCELLED), so writing it on a
# delivered event strikes that event off the owner's subscribed calendar. Default on. Honored
# only when `RUN_SCHEDULERS` is not `false`.
RUN_SHIFT_CLOSURE_SWEEP_SCHEDULER=

# Optional. Set to `false` to disable the hourly balance-invoice monitor
# (`balanceInvoiceMonitor.js`): it alerts when a client is billed MORE than they owe, or owes a
# balance with no payable invoice. ALERT ONLY: it never creates/edits/voids an invoice.
# Default on. Honored only when `RUN_SCHEDULERS` is not `false`.
RUN_BALANCE_INVOICE_MONITOR=

# Declared again below (after `VA_INBOUND_PER_MIN_CAP`), where its full description is; dotenv
# keeps the last declaration.
RUN_VA_CALLING_SCHEDULER=

# Optional. Set to `false` to disable the presence tracker sweep (every 15 min: the stale-desk
# nudge via Telegram/SMS + the auto-flip to away on silence). Default on. Honored only when
# `RUN_SCHEDULERS` is not `false`.
RUN_PRESENCE_SCHEDULER=

# ─── Web Push (VAPID) - staff portal push notifications (spec §6.17) ──────

# Required for push. The Web Push (VAPID) keypair for staff-portal push notifications (spec
# §6.17). Generate it once with `npx web-push generate-vapid-keys`. VAPID identifies this app
# server to the browsers' push services.
# VAPID_PUBLIC_KEY: the public key, shared with the client: the same value is exposed to the
# client as `REACT_APP_VAPID_PUBLIC_KEY`. Since 2026-10-14 the admin phone's push uses the same
# pair: the admin phone reads the public key from `GET /api/me/notification-preferences`
# (`push.public_key`, served only when the private key is also set), so the admin push needs
# nothing in Vercel.
# VAPID_PRIVATE_KEY: the private key, server-only: never commit it, never expose it to the client.
# When it is unset the push sender fails closed (returns `vapid_unset`) and the server still boots
# normally; SMS + email keep covering every notification. Push is purely additive. Sends are also
# gated by `SEND_NOTIFICATIONS` (above).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Required for staff push. The client-side copy of `VAPID_PUBLIC_KEY` (the identical value),
# exposed to the client build (`client/.env*`) and used by the staff portal to subscribe the
# browser to push. Set it on the client side (Vercel). Staff portal only; the admin phone never
# reads it.
REACT_APP_VAPID_PUBLIC_KEY=
# Required for push. The code treats it as optional and defaults it, as the next line says.
# Contact email embedded in the VAPID JWT (mailto:). Defaults to contact@drbartender.com.
VAPID_CONTACT_EMAIL=contact@drbartender.com

# ─── Zul VA Calling (Telegram-triggered Twilio callback bridge) ───────────
# Our PH-based VA (Zul) places/receives US calls via a Twilio callback bridge:
# the OUTBOUND trigger is a Telegram bot message; voice rides her CELL (Twilio
# calls her, she answers, Twilio bridges the second leg to the target with the
# 224 as caller ID). This endpoint dials billed international calls on an
# auto-refill account from external input, so it is a toll-fraud target; every
# guard (secret path + secret_token header + user_id allowlist + US-only NANP
# validation + confirm-before-dial + spend caps) is load-bearing. See
# docs/superpowers/specs/2026-07-01-zul-va-calling-design.md and
# docs/va-calling-runbook.md.

# Required for VA calling. Telegram Bot API token from @BotFather, for the Zul VA-calling trigger.
# When unset, the Telegram helpers `sendTelegramMessage`/`setTelegramWebhook` no-op (log + skip)
# and the outbound trigger, so all outbound calling, is dead.
TELEGRAM_BOT_TOKEN=

# Required for VA calling. Doubles as the secret, unguessable URL path segment
# (`/api/telegram/<secret>`) AND the value compared constant-time against the
# `X-Telegram-Bot-Api-Secret-Token` header on every update. Set the SAME value at `setWebhook`.
# Never commit it. Unset → `verifyTelegramSecret` returns false (all updates 403). Generate:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=

# Required (bootstrap). Numeric Telegram user id of Zul: the ONLY sender allowed to trigger a
# call. BOOTSTRAP: leave UNSET on the first deploy. **When UNSET the webhook runs in bootstrap
# mode**: it replies to any sender with their own user id and dials nothing. Read Zul's
# id from that reply, set it here, redeploy. Once set, every other sender is a silent no-op.
TELEGRAM_ALLOWED_USER_ID=

# Required for VA calling. The 224 US voice line ending 0082, in strict E.164 (the value on the
# line below). Caller ID on Zul's outbound calls AND her inbound line, the number clients dial
# inbound to reach her; since Phase 1a the number ADVERTISED to clients for calls is the 1922
# (`COMPANY_PHONE`). Voice+SMS capable; no SMS-to-clients from it.
VOICE_CALLER_ID=+12242220082

# Required for VA calling. Zul's cell in strict E.164 (`+63…`), the bridge target Twilio calls.
# **NEVER run it through `normalizePhone`** (US-centric; it would mangle a PH number). Stored
# only here: never on a DB record, never committed to the repo.
VA_CELL=

# ── 224-inbound voicemail (spec 2026-07-22) ─────────────────────────────────

# 224-inbound voicemail master switch, **DEFAULT OFF**: only the literal string `'true'` enables
# it. Off means a missed inbound call hangs up exactly as it did before the feature: no Telegram
# ping, no greeting, no recording. Ships dark; flip it in Render after the live call test.
VOICEMAIL_ENABLED=false

# Max voicemail recording length in seconds (default 120, parsed and clamped to 30..300). Per-call
# recording spend cap.
VM_MAX_LENGTH_SEC=120

# Max voicemail-path calls per rolling 24h (default 50), counted from `voicemail_delivery`. The
# inbound analog of `VA_CALL_DAILY_CAP`: a missed call used to cost nothing after ring timeout,
# and now costs greeting + up to `VM_MAX_LENGTH_SEC` of billed recording. On trip the missed
# handler hangs up and sends no ping.
VM_DAILY_CAP=50

# Optional. Source of Zul's DAY voicemail greeting on the 224 line. Unset (default) → her BUNDLED
# 2026-08-19 re-recording, `server/assets/zul-greeting-day.mp3`, served at
# `/api/voice/audio/zul-greeting-day.mp3`. The literal `say` → the synthetic Zul text in the
# `Polly.Joanna-Neural` voice (a known-good kill switch if a recording regresses), which mirrors
# the recording word for word and therefore also offers press 1. A full https URL → `<Play>` it
# without a redeploy.
# Her bundled default and the synthetic text BOTH say the press-1 offer, which is what stops the
# synthetic prompt being appended after it. An override URL is assumed NOT to say it, so the
# offer IS appended after one.
# The older 2026-07-24 take (`voicemail-greeting.mp3`) is still served at the public
# `GET /api/voice/greeting.mp3` for anything referencing that URL directly, but it is no longer
# any slot's default.
# VM_GREETING_URL=

# ── Phone system Phase 1a (spec 2026-07-26) ─────────────────────────────────

# Required*. (*Required once the 1922's voice webhook points at us.)
# What the primary line (+12242221922) dials to reach Dallas. Strict E.164.
# Normally the 312 Google Voice (GV) number, which rings his phone and keeps his personal cell
# private. Unset means the primary line apologizes and hangs up rather than emitting an empty
# `<Dial>`, and pages Sentry (throttled): primary calls are apologized away.
VM_PRIMARY_DIAL_TARGET=+1xxxxxxxxxx
# Ring seconds on the primary line before Twilio calls it a miss (default 18, clamped 5..30).
# Deliberately SHORTER than a typical carrier/Google Voice (GV) voicemail pickup (~25s), so their
# voicemail can never intercept ours: if their voicemail answers first, Twilio reports completed
# and the caller lands in a dumb voicemail we cannot route.
VM_PRIMARY_RING_SEC=18
# Required* (the same footnote as VM_PRIMARY_DIAL_TARGET: once the 1922's voice webhook points at
# us). Where a voicemail on the primary line is texted (the 312), strict E.164. Sent from
# `TWILIO_PHONE_NUMBER` (the 888 until Phase 2) with `skipLog`, so this internal ops alert never
# lands in a client's message ledger. Unset or malformed SILENTLY DISABLES primary-line delivery:
# rows stay retryable, but nothing sends and only a startup warning + per-call log says why. The
# consult call bridge reuses it as its text destination, for its missed-consult and
# client-did-not-answer texts, falling back to `ADMIN_PHONE`; when neither is strict E.164, or the
# text fails, the missed chain and the client-did-not-answer report each send the admin email
# instead, so the consult is never invisible.
VM_TEXT_DESTINATION=+1xxxxxxxxxx
# Listen-link kill switch (spec 2026-08-10), **default ON**: only the literal `'false'` disables
# it. TWO-SIDED: off → `GET /api/voice/vm/:token` closes (it 404s) AND the primary alert SMS
# omits the link line; one `listenLinkEnabled()` in `utils/voicemail.js` feeds both, so they
# cannot drift and flipping it never strands a dead URL in an alert. The route serves a client's
# recorded voice to whoever holds the token, so it gets the same redeploy-free off switch as the
# other PII surfaces. The token IS the auth, and the link is only ever sent to
# `VM_TEXT_DESTINATION` (the operator, who can already hear every voicemail in the Twilio
# console): that, NOT the proposal/invoice precedent, is what makes a bare UUID acceptable on
# third-party audio. Links expire at 30 days, enforced in the route's own SQL. To revoke ONE link
# instead of all of them:
# UPDATE voicemail_delivery SET listen_token = gen_random_uuid() WHERE call_sid = $1;
VM_LISTEN_LINK_ENABLED=true
# Dallas's DAY greeting, same contract as `VM_GREETING_URL` but for the primary line. Unset → his
# BUNDLED recording (`server/assets/primary-greeting-day.mp3`, recorded 2026-08-19); `say` → the
# synthetic Dallas text; a full https URL → `<Play>` it. Never falls back to Zul's recording.
# The bundled default and the synthetic text BOTH say the press-1 offer. An override URL is
# assumed NOT to, so the offer is appended after it.
# VM_GREETING_URL_PRIMARY=
# Press-1 escalation master switch, **default OFF** (only `'true'` enables). What it guarantees,
# precisely: NO escalation is ever claimed and NO billed leg is ever dialed.
# `voiceEscalate.js` tests this switch itself, so that holds no matter what the caller presses.
#
# What it does NOT do, since 2026-08-19, is remove the OFFER from the caller experience: both
# lines' day greetings say "press one" inside the recording, and no env var can edit an mp3. Until
# 2026-08-20 flipping this off also dropped the `<Gather>`, which made the switch a trap: callers
# were invited to press a key nobody was listening for, pressed 1 into a document that was not
# listening, and dropped to the beep. The `<Gather>` now follows the GREETING rather than this
# switch (fix 2026-08-20), so off still emits the `<Gather>` in the DAY, and with escalation off a
# pressed digit plays the `escalate_failed` recording ("sorry, nobody's available right now") and
# records, exactly as the quiet window and the daily cap already do. Night emits no `<Gather>`
# either way. The old claim (off meaning no `<Gather>` on either line, the zul document
# "byte-identical to pre-feature production", golden-pinned) died with the 2026-08-19
# re-recording; the golden pins now assert the CURRENT documents.
#
# TWO CORRECTIONS LIVE HERE, and the second one corrects the first attempt at
# the first one. Read both before prescribing anything about this switch.
#
# (a) The 2026-08-19 note prescribed VM_ESCALATION_ENABLED=false +
#     VM_NIGHT_WINDOW=none + VM_GREETING_URL_PRIMARY=say as "the real
#     three-variable revert". It does not work: 'say' resolves to the SYNTHETIC
#     text, which mirrors the recording word for word and so also says "press
#     one". It only changes whose voice makes the offer.
#
# (b) The 2026-08-20 replacement for (a) was ALSO WRONG, found by the review
#     fleet the same evening. It said to record a no-offer greeting, point
#     VM_GREETING_URL_PRIMARY / VM_GREETING_URL at it, and flip that slot's
#     defaultSaysOffer to false. Setting the env var DEFEATS the flag: both
#     dayGreetingOffersPress1 and needsAppendedOffer short-circuit on a playable
#     URL and return before defaultSaysOffer is ever read, because an override
#     recording's script is unknown and the safe assumption is that it offers.
#     So the <Gather> stays; and with escalation ON the synthetic offer is
#     APPENDED to your new no-offer recording, re-adding in Polly's voice the
#     exact sentence you recorded it to remove.
#
# THE RECIPE THAT ACTUALLY WORKS, and it is a code change, not a config one:
# replace the slot's BUNDLED file in voicemailTwiml.js SLOTS with a recording
# that does not say the offer, flip that slot's defaultSaysOffer to false, and
# leave the env var UNSET so the table is what answers. voice.js then stops
# emitting the <Gather> for that line by day with no further edit, and a route
# test pins exactly that. There is still no env-only way to remove the offer.
VM_ESCALATION_ENABLED=false
# Max escalation legs per rolling 24h (default 25), enforced as a HARD bound: the cap-check and
# the claim run in one serialized transaction, serialized on an advisory lock. Toll-fraud bound: a
# press-1 is a billed outbound leg, and on the primary line it is INTERNATIONAL.
VM_ESCALATION_DAILY_CAP=25
# Quiet hours for the person being escalated TO, the escalation TARGET (ZUL for Zul, PRIMARY for
# Dallas on the primary line), local to them, in STRICT `HH:MM-HH:MM` (leading zeros required;
# `24:00` and en dashes are invalid and are treated, with a warning, as no window). Inside the
# window the escalation is skipped and the caller goes straight to voicemail. Windows may wrap
# midnight.
VM_ESCALATION_QUIET_ZUL=22:00-08:00
VM_ESCALATION_QUIET_PRIMARY=22:00-08:00
# Optional IANA zone overrides for those quiet windows (defaults Asia/Manila for Zul,
# America/Chicago for Dallas). A BAD zone name silently disables the window (fail-open on a live
# call path; a per-call warning is the only signal).
# VM_ESCALATION_TZ_ZUL=Asia/Manila
# VM_ESCALATION_TZ_PRIMARY=America/Chicago
# Manual override suppressing the APPENDED press-1 offer everywhere. Since 2026-08-19 the day
# greetings say the offer themselves, so whether to append is decided from the slot table:
# `needsAppendedOffer()` trusts only the KNOWN defaults, and BOTH lines now default to 2026-08-19
# recordings that say it, so nothing is appended by default and this switch should not be needed.
# An override URL has UNKNOWN content and DOES get the offer appended, on either line (a doubled
# offer is an obvious stutter; a missing one is invisible). Set this to suppress that after wiring
# an override recording that already announces the option.
# VM_ESCALATION_PROMPT=none
# Caller communication (spec 2026-08-19). The night window for the CALLER-facing experience:
# inside it the greeting drops the press-1 offer and promises the morning instead. Strict
# `HH:MM-HH:MM`, may wrap midnight. Default `21:00-09:00`. The literal `none` disables night
# entirely, so night mode can be turned off without an invalid value that warns per call. NOT the
# same thing as `VM_ESCALATION_QUIET_*`, which protect the person being DIALED, in THEIR timezone,
# and suppress only the dial. This one is about the caller and changes the greeting itself. An
# unparseable value fails OPEN to day, so the failure mode is a phone that rings, never a caller
# silently denied the offer of a human.
# VM_NIGHT_WINDOW=21:00-09:00
# IANA zone for `VM_NIGHT_WINDOW` (the window above), default `America/Chicago`. A bad zone name
# fails open to day.
# VM_NIGHT_TZ=America/Chicago
# The four message slots per line. Since 2026-08-19 BOTH lines default to their owner's bundled
# recordings for all four slots, so none of these has to be set; the synthetic texts are the kill
# switch, not the normal path. Same contract as `VM_GREETING_URL` throughout: unset uses the
# default, the literal 'say' forces synthetic (the kill switch for a bad recording), a full https
# URL is <Play>ed.
# This pair is the night greeting per line; the primary defaults to the bundled
# `primary-greeting-night.mp3`.
# WARNING, and nothing in the code can enforce it: a NIGHT greeting must never
# mention press 1. The day path detects an unknown override and listens anyway
# (dayGreetingOffersPress1 assumes a recording it cannot read DOES offer), but
# night is hard-coded to emit no <Gather> at all, switch on or off, and the night
# slots carry no defaultSaysOffer flag for anything to check. The asymmetry is
# deliberate -- a night press-1 rings a sleeping phone -- but it means a night
# recording that offers a human recreates exactly the trap the day path closed on
# 2026-08-20, silently. Listen to any night recording before pointing these here.
# VM_NIGHT_GREETING_URL_PRIMARY=
# VM_NIGHT_GREETING_URL=
# The press-1 acknowledgment per line, played the instant a caller presses 1, BEFORE any ringing.
# The primary defaults to the bundled `primary-escalate-ack.mp3`.
# VM_ESCALATE_ACK_URL_PRIMARY=
# VM_ESCALATE_ACK_URL=
# The escalation-failed message per line, played whenever escalation returns the caller to
# voicemail (seven of the eight branches; the rate-limiter handler carries the same message
# inline). The primary defaults to the bundled `primary-escalate-failed.mp3`.
# VM_ESCALATE_FAILED_URL_PRIMARY=
# VM_ESCALATE_FAILED_URL=

# Call caps and call bridges (VA calling, lead calls, consult calls, Thumbtack first-reply)

# Global inbound-call flood cap per minute (default 30 per line) on `POST /api/voice/inbound` AND
# `POST /api/voice/inbound/primary`, each line in its own bucket so a storm on one
# number cannot silence the other; on trip it returns busy TwiML and never dials. Runs BEHIND the
# signature gate so unsigned floods cannot consume it. The voicemail and escalation webhooks have
# their own per-`CallSid` limiters that do not read this var.
VA_INBOUND_PER_MIN_CAP=30

# Optional. Set to `false` to disable the VA-calling maintenance scheduler: the hourly prune of
# expired `pending_call` + retention-aged `call_audit`/`telegram_update`/`voicemail_delivery`
# rows, the undelivered-voicemail redelivery sweep, the lead-call stale reaper, and the ~6h
# Telegram webhook-heartbeat check. The sweep is the ONLY retry for a voicemail stranded between
# claim and upload, so turning this off while `VOICEMAIL_ENABLED` is on leaves that feature with
# no recovery path. It no longer touches consult rows: the consult-call reaper moved to the
# consult sweep (spec 2026-09-30), see `RUN_CONSULT_CALL_SWEEP_SCHEDULER`. Default on. Honored
# only when `RUN_SCHEDULERS` is not `false` (the global flag wins).
RUN_VA_CALLING_SCHEDULER=

# Optional spend caps (toll-fraud controls). Defaults shown. When the daily or the per-minute cap
# trips, the bot tells Zul and no call is placed.
#   VA_CALL_DAILY_CAP       max calls placed per rolling 24h (default 40, DB-backed by counting
#                           `call_audit`)
#   VA_CALL_PER_MIN_CAP     max triggers accepted per minute (default 5)
#   VA_CALL_TIME_LIMIT_SEC  per-call hard `timeLimit` on BOTH call legs (default 1800 = 30 min);
#                           both the lead-call and consult-call bridges reuse the same value, on
#                           their agent legs and on their press-1 bridges
#   PENDING_CALL_TTL_SEC    how long a confirm-before-dial pending record lives: its TTL in
#                           seconds (default 120)
VA_CALL_DAILY_CAP=40
VA_CALL_PER_MIN_CAP=5
VA_CALL_TIME_LIMIT_SEC=1800
PENDING_CALL_TTL_SEC=120

# Lead call bridge (real-time first-ring on new Thumbtack leads).
#   LEAD_CALL_ENABLED     kill switch; `false` disables the new-Thumbtack-lead auto-call trigger
#                         entirely (redeploy-free, `HARVESTER_ENABLED` precedent). Default on:
#                         set `false` in Render BEFORE the feature's first deploy (ship dark until
#                         the live relay test passes).
#   LEAD_CALL_DAILY_CAP   max lead-call attempt chains opened per rolling 24h (default 25).
#                         Toll-fraud backstop for the lead call bridge; normal volume is ~2-3
#                         leads/day. NOTE: `0` is NOT an off switch: `parseInt(...) || 25` (the
#                         NaN-guard) treats it as unset and falls back to 25. The only off switch
#                         is `LEAD_CALL_ENABLED=false`.
LEAD_CALL_ENABLED=
LEAD_CALL_DAILY_CAP=25

# Consult call bridge (auto-dial Dallas at each Cal.com consult slot; spec 2026-08-25).
#
# CONSULT_CALL_ENABLED: the kill switch; only the literal `false` disables it. Off, the Cal.com
# webhook tail does nothing, the 60-second sweep opens, files and rings nothing, the ring-3 hop to
# Zul and the missed-chain text are refused (a client-no-answer report from a bridge already
# under way still goes out), answering a ring speaks the off message, "The consult call bridge is
# turned off", and press-1 dials nothing, and a ring 1, 2 or 3 that ends parks its chain
# `skipped_disabled`. The sweep's stale reap still runs while off, parking stranded chains
# `skipped_disabled` silently, with no email (spec 2026-09-30). Default on: set `false` in Render
# BEFORE the feature's first deploy, and flip it after the launch call test passes.
#
# CONSULT_CALL_DAILY_CAP: max consult ring chains opened per rolling 24h (default 10). Toll-fraud
# backstop; `0` is NOT off: it is treated as unset (`parseInt || 10`, the NaN-guard) and falls
# back to 10, so the only off switch is `CONSULT_CALL_ENABLED=false`. The Cal.com booking page is
# PUBLIC, so this value sets THREE ceilings at once and you cannot raise one without raising the
# others.
# (a) Chains opened: the count excludes `status LIKE 'skipped%'`, counting only
# `status NOT LIKE 'skipped%'` (ruling R15), so a chain ending `skipped_cancelled` frees its slot
# again -- deliberate, because counting skipped rows would let a burst of junk bookings on the
# public page hold the whole feature down for 24 hours. That bounds the Manila legs and texts at
# this value.
# (b) Rings placed at `ADMIN_PHONE` in the same window: `dialCap()` = this value x
# `MAX_ADMIN_RINGS` (3), so 30 by default, counted from `call_audit` rows (status
# `consult_placed_admin`, one per ring actually placed) in the rolling 24h, and checked in
# `advanceChain`.
# (c) Legs placed to Zul: `vaLegCap()` = this value, counted the same way (`consult_placed_va`).
# The two leg ceilings count `call_audit` rows, one per leg actually placed, a ledger nothing else
# deletes (no chain transition or reschedule deletes it). They exist because the first ceiling
# alone left cancel-and-rebook unbounded: guard (b) exists because R15 left the book, ring,
# cancel, rebook cycle unbounded on the admin leg, and it is what makes the documented worst case
# a ceiling rather than a description. Raising this widens a public surface on all three, so
# treat any edit as a security change.
#
# CONSULT_CALLER_ID: strict E.164, the 1922 (the company line printed on proposals): the caller
# ID the client sees when Dallas pressed 1, so their callback rings the company line.
# FORMAT-checked, not presence-checked, at boot and again per call, because a typo would make
# every press-1 `<Dial>` fail at Twilio while the row already reads `connected`, and the only
# alert is the reaper's bridge-unconfirmed email, 40 minutes later. Unset or malformed falls back
# to `VOICE_CALLER_ID` (the 0082, Zul's line) with a boot warning; Zul's own press-1 always shows
# the 0082.
#
# RUN_CONSULT_CALL_SWEEP_SCHEDULER: optional; set to `false` to disable the 60-second consult call
# sweep (it opens a chain per upcoming Cal.com slot, files the slots that passed unrung, its
# missed windows, and places each due ring) AND the consult-call reaper it runs every tick
# (`consultCallReaper.js`: fails a chain stranded mid-ring 30 minutes past its slot, and flips a
# press-1 Twilio never reported to `failed` / `bridge_unconfirmed`). The stale half still runs
# with `CONSULT_CALL_ENABLED=false`, parking stranded chains silently. Setting THIS flag `false`
# leaves NO consult reaper at all, no rescue for a stranded chain, which is acceptable only while
# the feature is off. Default on. Honored only when `RUN_SCHEDULERS` is not `false`.
CONSULT_CALL_ENABLED=
CONSULT_CALL_DAILY_CAP=10
CONSULT_CALLER_ID=+12242221922
RUN_CONSULT_CALL_SWEEP_SCHEDULER=

# TT auto first-reply (respond-then-ring): the harvester box sends Dallas's saved day/night quick
# reply on every new lead; day-lead calls fire only after the reply is confirmed.
#   TT_AUTOREPLY_ENABLED               master switch, **DEFAULT OFF** (`'true'` to enable). Gates
#                                      the webhook-tail fork (enqueue vs direct call) AND empties
#                                      the agent offer endpoint. Deliberately does NOT gate the
#                                      fallback sweep, so a rollback flip still drains in-flight
#                                      day leads.
#   FIRST_REPLY_FALLBACK_MINUTES       the day-lead call fires anyway when the reply is
#                                      unconfirmed past this fallback threshold (default 3 min)
#   FIRST_REPLY_CALL_MAX_AGE_MINUTES   the freshness bound on callback/sweep calls: no callback
#                                      or sweep call ever fires for a lead older than it (default
#                                      240 min; the promise of a call expires)
#   RUN_FIRST_REPLY_FALLBACK_SCHEDULER optional; `false` disables the 60s first-reply sweep (call
#                                      fallback + strand hygiene). Default on. Honored only when
#                                      `RUN_SCHEDULERS` is not `false` (the global flag wins).
#   MAX_FIRST_REPLY_ATTEMPTS           the offer-side attempts cap before a queued reply flips to
#                                      `failed` (default 3; the OFFER bumps the counter, so a
#                                      dead agent still hits the cap)
#   FIRST_REPLY_COOLDOWN_INTERVAL      the reply lease re-offer interval (default `'10 minutes'`)
#   FIRST_REPLY_NIGHT_JITTER_START_HOUR / _END_HOUR   the Chicago dead-hours window `[start, end)`
#     in which night-template leads get the 2-14 min reply jitter; outside it night replies are
#     immediate. Defaults 2 and 8: "night leads are fast until 2am"
#     (2026-08-03). May wrap midnight (e.g. 23/6 = 11pm-6am); start == end disables the jitter
#     entirely.
TT_AUTOREPLY_ENABLED=
FIRST_REPLY_FALLBACK_MINUTES=3
FIRST_REPLY_CALL_MAX_AGE_MINUTES=240
RUN_FIRST_REPLY_FALLBACK_SCHEDULER=
MAX_FIRST_REPLY_ATTEMPTS=3
FIRST_REPLY_COOLDOWN_INTERVAL='10 minutes'
FIRST_REPLY_NIGHT_JITTER_START_HOUR=2
FIRST_REPLY_NIGHT_JITTER_END_HOUR=8
# Breathing room between the confirmed/failed first reply and the promised lead call (default
# 60s; 0 = immediate; clamped to 0-600). In-process timer; the 60s sweep (Arm A) is the restart
# backstop and defers flipped rows by delay+60s, so it never preempts the breathing room, and the
# `lead_id`-UNIQUE attempt open absorbs double-fires. A delay that would cross the 23:00 clamp
# fires immediately instead (never converts a placeable call into an after-hours skip).
FIRST_REPLY_CALL_DELAY_SECONDS=60

# Marketing sends (Resend)

# Optional. Milliseconds between recipients in a marketing campaign send
# (`server/routes/marketingSend.js`, default 600). Resend's published limit is 2
# requests/second; the send is paced SERIALLY rather than bursting, because a burst that trips the
# limit fails an arbitrary subset and leaves a partially-sent campaign nobody can resume
# confidently. Set it to `0` in tests. Raising it makes a 500-recipient send take proportionally
# longer in one open HTTP request.
# MARKETING_SEND_GAP_MS=600

# Optional. Resend's daily sending allowance (default 100, the free tier). Surfaced on the
# Marketing Overview as today's send budget and used to flag a moment whose audience will not fit
# in one day. NOTE the budget counts CAMPAIGN sends only (`email_sends`); the real allowance is
# also consumed by proposals, invoices and the lifecycle touches, so remaining is an upper bound.
# RESEND_DAILY_CAP=100
